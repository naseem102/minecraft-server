# Minecraft Server - Ignore runtime & large files

# World data (very large)
world/
world_nether/
world_the_end/

# Logs
logs/
*.log

# Crash reports
crash-reports/

# Player data & cache
usercache.json
usernamecache.json

# Libraries & downloaded deps (regenerated on first run)
libraries/
versions/

# Temporary / cache
.cache/
tmp/
*.tmp

# OS junk
Thumbs.db
Desktop.ini
.DS_Store

# Note: server.jar is intentionally NOT ignored so you can commit it if desired
# (though committing large binaries is generally discouraged)

# ngrok config if any
ngrok.yml

# Local overrides
local.properties
*.local
